@"
# Python
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# Temporary files
*.log
.DS_Store
Thumbs.db
"@ | Set-Content .gitignore

git add .gitignore
git commit -m "Resolve .gitignore merge conflict"
git push -u origin main